rules_version = '2';

// قواعد أمان haipad — الأصل: لا شيء مسموح إلا ما يُذكر هنا.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    // صورة الغلاف: رابط أو صورة مصغّرة محفوظة كنص (أقل من ~150 ألف حرف)
    function validCover(d) {
      return !('cover' in d) || (d.cover is string && d.cover.size() <= 150000);
    }
    function storyDoc(sid) {
      return /databases/$(database)/documents/stories/$(sid);
    }
    // صاحب القصة (يُقيَّم قبل/بعد الكتابة في الدفعة الواحدة)
    function ownsStory(sid) {
      return signedIn() && get(storyDoc(sid)).data.authorId == request.auth.uid;
    }
    function ownsStoryAfter(sid) {
      return signedIn() && getAfter(storyDoc(sid)).data.authorId == request.auth.uid;
    }

    // ───────── المستخدمون ─────────
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isUser(uid)
        && validText(request.resource.data.name, 40)
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0;

      allow update: if
        // صاحب الحساب يعدّل بياناته (دون المساس بعدّاد المتابعين)
        (isUser(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount'])
          && validText(request.resource.data.name, 40))
        ||
        // غيره يستطيع فقط زيادة/إنقاص عدّاد المتابعين مع إنشاء/حذف وثيقة المتابعة
        (signedIn()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
          && (
            (request.resource.data.followersCount == resource.data.followersCount + 1
              && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
            ||
            (request.resource.data.followersCount == resource.data.followersCount - 1
              && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)))
          ));

      match /following/{target} {
        allow read, write: if isUser(uid);
      }
      match /followers/{follower} {
        allow read: if signedIn();
        allow create, delete: if isUser(follower);
      }
      match /library/{sid} {
        allow read, write: if isUser(uid);
      }
      match /lists/{listId} {
        allow read: if signedIn();
        allow write: if isUser(uid);
      }
      match /wall/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.text, 500);
        allow delete: if isUser(uid) || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // ───────── القصص ─────────
    match /stories/{sid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validCover(request.resource.data)
        && validText(request.resource.data.title, 150)
        && request.resource.data.reads == 0
        && request.resource.data.votes == 0;

      allow update: if
        // الكاتب يعدّل قصته (دون تغيير الكاتب)
        (signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && validCover(request.resource.data))
        ||
        // أي مستخدم يزيد عدّاد القراءات بمقدار 1 فقط
        (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
          && request.resource.data.reads == resource.data.reads + 1)
        ||
        // أي مستخدم يصوّت/يلغي تصويته (±1) مع إنشاء/حذف وثيقة تصويته
        (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && (
            (request.resource.data.votes == resource.data.votes + 1
              && !exists(/databases/$(database)/documents/stories/$(sid)/votes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/stories/$(sid)/votes/$(request.auth.uid)))
            ||
            (request.resource.data.votes == resource.data.votes - 1
              && exists(/databases/$(database)/documents/stories/$(sid)/votes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/stories/$(sid)/votes/$(request.auth.uid)))
          ));

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // الفصول: المنشورة للجميع، والمسودات لصاحب القصة فقط
      match /chapters/{cid} {
        allow read: if signedIn() && (resource.data.published == true || ownsStory(sid));
        allow create, update: if ownsStoryAfter(sid)
          && validText(request.resource.data.title, 200)
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 200000
          && request.resource.data.published is bool;
        allow delete: if ownsStoryAfter(sid);
      }

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.text, 1000);
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || ownsStory(sid));
      }

      match /votes/{uid} {
        allow read: if isUser(uid) || ownsStory(sid);
        allow create: if isUser(uid);
        allow delete: if isUser(uid) || ownsStory(sid);
      }
    }

    // ───────── الغرف العامة ─────────
    match /rooms/{room}/messages/{mid} {
      allow read: if signedIn() && room in ['writers', 'horror', 'romance'];
      allow create: if signedIn()
        && room in ['writers', 'horror', 'romance']
        && request.resource.data.uid == request.auth.uid
        && validText(request.resource.data.text, 1000);
    }

    // ───────── الرسائل الخاصة ─────────
    match /conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && cid == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.text, 2000)
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.participants;
      }
    }
  }
}
